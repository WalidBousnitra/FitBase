<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="@dimen/space_lg">

    <include layout="@layout/partial_header" />

    <!-- Fase actual -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_md"
        android:background="@drawable/bg_card_flat">

        <TextView
            android:id="@+id/tvFaseActual"
            style="@style/TextAppearance.FitBase.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fase actual"
            android:textColor="@color/colorAccentPrimary" />

        <TextView
            android:id="@+id/tvProgreso"
            style="@style/TextAppearance.FitBase.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="11 meses · 31/08/2026 → 31/07/2027"
            android:layout_marginTop="@dimen/space_xxs" />
    </LinearLayout>

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorSeparator"
        android:layout_marginBottom="@dimen/space_sm" />

    <!-- Lista de fases -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFases"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
