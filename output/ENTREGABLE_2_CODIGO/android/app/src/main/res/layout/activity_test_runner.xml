<?xml version="1.0" encoding="utf-8"?>
<!-- Test Runner — Solo disponible en modo DEMO -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Test Runner"
            android:textSize="22sp"
            android:textColor="@color/colorTextPrimary"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/btnCerrar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/button_secondary"
            android:text="Cerrar"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Resumen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvResumen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pulsa para ejecutar todos los tests"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnEjecutar"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/gradient_primary_button"
            android:text="▶ Ejecutar"
            android:textColor="@color/colorBackground"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/btnCompartir"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="8dp"
            android:background="@drawable/button_secondary"
            android:text="Compartir"
            android:textColor="@color/colorTextPrimary"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progressTests"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorSeparator"
        android:layout_marginVertical="8dp" />

    <!-- Resultados -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvResultados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/colorTextPrimary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

</LinearLayout>
