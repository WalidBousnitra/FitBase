<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sesión completada"
        android:textSize="24sp"
        android:textColor="@color/success" />

    <TextView
        android:id="@+id/tvSummarySeries"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="24 series"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvSummaryVolumen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="4500 kg total"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvSummaryRir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RIR medio 2.0"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvSummaryIntensidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alta — zona óptima hipertrofia"
        android:textSize="14sp"
        android:textColor="@color/success"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvSummaryImpacto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="El motor ajustará tu próxima sesión."
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnSummaryCerrar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:text="CERRAR"
        android:background="@drawable/gradient_primary_button"
        android:textColor="@color/white" />

</LinearLayout>
