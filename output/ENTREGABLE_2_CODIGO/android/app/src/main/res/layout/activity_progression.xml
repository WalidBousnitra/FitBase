<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xl">

        <include layout="@layout/partial_header" />

        <TextView
            style="@style/TextAppearance.FitBase.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seguimiento de métricas clave"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_lg" />

        <!-- Filtros de tiempo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_xl">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn7d"
                style="@style/Widget.FitBase.Button.Filter"
                android:text="7d"
                android:layout_marginEnd="@dimen/space_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn30d"
                style="@style/Widget.FitBase.Button.Filter"
                android:text="30d"
                android:layout_marginEnd="@dimen/space_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn90d"
                style="@style/Widget.FitBase.Button.Filter"
                android:text="90d" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvError"
            style="@style/TextAppearance.FitBase.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/error"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/space_lg" />

        <!-- ═══ RESUMEN CARDS ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_md">

            <!-- Peso -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_flat"
                android:padding="@dimen/card_padding"
                android:layout_marginEnd="@dimen/space_sm">

                <TextView
                    style="@style/TextAppearance.FitBase.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PESO" />

                <TextView
                    android:id="@+id/tvPesoActual"
                    style="@style/TextAppearance.FitBase.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— kg" />

                <TextView
                    android:id="@+id/tvPesoCambio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="12sp"
                    android:textColor="@color/success" />
            </LinearLayout>

            <!-- Grasa -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_flat"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/TextAppearance.FitBase.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GRASA" />

                <TextView
                    android:id="@+id/tvGrasaActual"
                    style="@style/TextAppearance.FitBase.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—%" />

                <TextView
                    android:id="@+id/tvGrasaCambio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="12sp"
                    android:textColor="@color/success" />
            </LinearLayout>
        </LinearLayout>

        <!-- Segunda fila: Sueño + Pasos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_xxl">

            <!-- Sueño -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_flat"
                android:padding="@dimen/card_padding"
                android:layout_marginEnd="@dimen/space_sm">

                <TextView
                    style="@style/TextAppearance.FitBase.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUEÑO" />

                <TextView
                    android:id="@+id/tvSleepMedia"
                    style="@style/TextAppearance.FitBase.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—" />
            </LinearLayout>

            <!-- Pasos -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_flat"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/TextAppearance.FitBase.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PASOS/DÍA" />

                <TextView
                    android:id="@+id/tvPasosMedia"
                    style="@style/TextAppearance.FitBase.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ EVOLUCIÓN: Peso, Grasa, Sueño, Pasos en una sola gráfica ═══ -->
        <TextView
            style="@style/TextAppearance.FitBase.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Evolución"
            android:layout_marginBottom="@dimen/space_sm" />

        <com.fitbase.ui.progression.ProgresionChartView
            android:id="@+id/chartProgresion"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginBottom="@dimen/space_md" />

        <!-- Leyenda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_xl">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/colorAccentPrimary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Peso"
                    android:textSize="12sp"
                    android:textColor="@color/colorTextSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/colorGrasa" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grasa"
                    android:textSize="12sp"
                    android:textColor="@color/colorTextSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/colorChartSecondary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sueño"
                    android:textSize="12sp"
                    android:textColor="@color/colorTextSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/colorSuccess" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pasos"
                    android:textSize="12sp"
                    android:textColor="@color/colorTextSecondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ DETALLE ENERGÍA Y ESTRÉS ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_sm">

            <TextView
                style="@style/TextAppearance.FitBase.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Energía y estrés (subjetivo)" />

            <TextView
                android:id="@+id/tvEstadoEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="22sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSubjetiva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="@dimen/space_xxxl" />

    </LinearLayout>
</ScrollView>
