<?xml version="1.0" encoding="utf-8"?>
<!-- Item de fase — Vivid: indicador lateral + fondo destacado si es actual -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardFase"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="@dimen/space_sm"
    android:background="@drawable/bg_card_flat">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding"
        android:gravity="center_vertical">

        <!-- Indicador de color por tipo (más grueso) -->
        <View
            android:id="@+id/indicadorColor"
            android:layout_width="5dp"
            android:layout_height="52dp"
            android:background="@color/colorSuccess"
            android:layout_marginEnd="@dimen/space_md" />

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFaseNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hipertrofia I"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvFaseFechas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="28 sep → 08 nov · 6 sem"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:layout_marginTop="@dimen/space_xxs" />

            <TextView
                android:id="@+id/tvFaseRir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RIR 2-3 · Hombros, Espalda"
                android:textColor="@color/colorTextTertiary"
                android:textSize="12sp"
                android:layout_marginTop="@dimen/space_xxs" />
        </LinearLayout>

        <!-- Badge "ACTUAL" para la fase actual -->
        <TextView
            android:id="@+id/badgeActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTUAL"
            android:textColor="@color/colorAccentPrimary"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:background="@drawable/bg_badge_actual"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
