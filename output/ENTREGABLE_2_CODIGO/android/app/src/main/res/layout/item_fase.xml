<?xml version="1.0" encoding="utf-8"?>
<!-- Item de fase en lista del plan anual -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFase"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Indicador de color por tipo -->
        <View
            android:id="@+id/indicadorColor"
            android:layout_width="4dp"
            android:layout_height="48dp"
            android:background="@color/colorSuccess"
            android:layout_marginEnd="12dp" />

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFaseNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hipertrofia I"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFaseFechas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="28/09 → 08/11 (6 sem)"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvFaseRir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RIR 2-3 | Hombros, Espalda"
                android:textColor="@color/colorTextTertiary"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
