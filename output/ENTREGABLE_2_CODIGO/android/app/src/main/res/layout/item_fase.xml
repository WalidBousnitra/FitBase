<?xml version="1.0" encoding="utf-8"?>
<!-- Item de fase — Linear: borde inferior fino -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardFase"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/colorSurface"
    android:paddingBottom="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Indicador de color por tipo -->
        <View
            android:id="@+id/indicadorColor"
            android:layout_width="4dp"
            android:layout_height="48dp"
            android:background="@color/colorSuccess"
            android:layout_marginEnd="12dp" />

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFaseNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hipertrofia I"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvFaseFechas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="28/09 → 08/11 (6 sem)"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvFaseRir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RIR 2-3 | Hombros, Espalda"
                android:textColor="@color/colorTextTertiary"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Separador fino -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorSeparator" />
</LinearLayout>
