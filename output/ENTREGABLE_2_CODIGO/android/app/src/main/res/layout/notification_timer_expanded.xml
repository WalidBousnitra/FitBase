<?xml version="1.0" encoding="utf-8"?>
<!-- Timer notification: expanded view (cuando termina, se hace grande) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1B2028">

    <!-- Título grande -->
    <TextView
        android:id="@+id/tvFinTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¡Siguiente serie!"
        android:textColor="#3B82F6"
        android:textSize="18sp"
        android:fontFamily="sans-serif-bold"
        android:gravity="center" />

    <!-- Ejercicio -->
    <TextView
        android:id="@+id/tvFinExercise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Press inclinado mancuernas"
        android:textColor="#F0F2F5"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <!-- Mensaje motivacional -->
    <TextView
        android:id="@+id/tvFinMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VAMOS — Toca para volver"
        android:textColor="#A8B3C0"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="6dp" />
</LinearLayout>
