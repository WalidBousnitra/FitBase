<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ═══ HEADER ═══ -->
        <TextView
            android:id="@+id/tvSaludo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buenos días"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="miércoles 2 de julio"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTipoDia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏋️ DÍA DE GYM"
                android:textSize="16sp"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/tvFaseNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hipertrofia I"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:background="@drawable/bg_badge_actual"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ═══ BANNER AUSENCIA ═══ -->
        <LinearLayout
            android:id="@+id/bannerAusencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_flat"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAusenciaMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- ═══ SUEÑO ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUEÑO"
                    android:textSize="11sp"
                    android:textColor="@color/text_tertiary" />
                <TextView
                    android:id="@+id/tvSleepScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="83/100"
                    android:textSize="22sp"
                    android:textColor="@color/success" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FC REPOSO"
                    android:textSize="11sp"
                    android:textColor="@color/text_tertiary" />
                <TextView
                    android:id="@+id/tvFcReposo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="53 bpm"
                    android:textSize="22sp"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAvisoFatiga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Sueño pobre — sesión reducida"
            android:textSize="13sp"
            android:textColor="@color/warning"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- ═══ MACROS RESTANTES ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MACROS RESTANTES"
            android:textSize="11sp"
            android:textColor="@color/text_tertiary"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tvCaloriasRestantes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3280"
            android:textSize="36sp"
            android:textColor="@color/accent"
            android:fontFamily="sans-serif-medium" />

        <ProgressBar
            android:id="@+id/progressCalorias"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:progressDrawable="@drawable/progress_calorias"
            android:max="3280" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PROT" android:textSize="10sp" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvProtRestante" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="156g"
                    android:textSize="18sp" android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="10dp"
                android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CARBOS" android:textSize="10sp" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvCarbosRestantes" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="488g"
                    android:textSize="18sp" android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="10dp"
                android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="GRASA" android:textSize="10sp" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvGrasasRestantes" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="78g"
                    android:textSize="18sp" android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="10dp"
                android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="AGUA" android:textSize="10sp" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvAgua" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="💧 3.2L"
                    android:textSize="14sp" android:textColor="@color/chart" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ PASOS Y CARDIO ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPasos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvPasosObj"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/ 8000 pasos"
                    android:textSize="14sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressPasos"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:progressDrawable="@drawable/progress_pasos"
                android:max="8000" />

            <TextView
                android:id="@+id/tvCardioInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏱️ 20 min bici post-gym"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ═══ MOVILIDAD MATUTINA ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_flat"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvMovilidadTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧘 Movilidad matutina (6 min)"
                android:textSize="14sp"
                android:textColor="@color/success" />

            <LinearLayout
                android:id="@+id/layoutMovilidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ═══ BOTÓN EMPEZAR ENTRENO ═══ -->
        <Button
            android:id="@+id/btnEmpezarEntreno"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="EMPEZAR ENTRENO"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:background="@drawable/gradient_primary_button"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tvSesionTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSesionFase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- ═══ NAVEGACIÓN ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btnPlanAnual"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Plan Anual"
                android:textSize="13sp"
                android:background="@drawable/button_secondary" />

            <Button
                android:id="@+id/btnProgresion"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Progresión"
                android:textSize="13sp"
                android:background="@drawable/button_secondary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
