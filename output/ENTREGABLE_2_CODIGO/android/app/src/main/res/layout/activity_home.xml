<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══ HERO: saludo + fecha + chips de estado ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hero_panel"
            android:paddingHorizontal="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvSaludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buenos días"
                android:textSize="23sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="miércoles 2 de julio"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTipoDia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/accent"
                    android:background="@drawable/bg_chip_accent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp" />

                <TextView
                    android:id="@+id/tvFaseNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Hipertrofia I"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_badge_actual"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

        <!-- ═══ BANNER AUSENCIA ═══ -->
        <LinearLayout
            android:id="@+id/bannerAusencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_flat"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAusenciaMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- ═══ BANNER RAMADÁN / EID (cultura.md §5-6) ═══ -->
        <LinearLayout
            android:id="@+id/bannerRamadan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_flat"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRamadanTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/tvRamadanDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- ═══ ESTADO: sueño + FC + pasos, todo en una tarjeta ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_flat"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SUEÑO"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:textColor="@color/text_tertiary" />
                    <TextView
                        android:id="@+id/tvSleepScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/colorSeparator" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FC REPOSO"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:textColor="@color/text_tertiary" />
                    <TextView
                        android:id="@+id/tvFcReposo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvAvisoFatiga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sueño pobre — sesión reducida"
                android:textSize="12sp"
                android:textColor="@color/warning"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorSeparator"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPasos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvPasosObj"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/ — pasos"
                    android:textSize="13sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressPasos"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:progressDrawable="@drawable/progress_pasos"
                android:max="8000" />

            <TextView
                android:id="@+id/tvCardioInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="20 min bici post-gym"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ═══ MACROS RESTANTES ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MACROS RESTANTES"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:textColor="@color/text_tertiary"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvCaloriasRestantes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="28sp"
            android:textColor="@color/accent"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02" />

        <ProgressBar
            android:id="@+id/progressCalorias"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="6dp"
            android:progressDrawable="@drawable/progress_calorias"
            android:max="3280" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="8dp">
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/colorProteina" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PROT" android:textSize="9sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvProtRestante" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/colorProteina" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="10dp"
                android:layout_marginStart="8dp">
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/colorCarbos" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CARBOS" android:textSize="9sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvCarbosRestantes" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/colorCarbos" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="10dp"
                android:layout_marginStart="8dp">
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/colorGrasa" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="GRASA" android:textSize="9sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvGrasasRestantes" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/colorGrasa" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="10dp"
                android:layout_marginStart="8dp">
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/colorAgua" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="AGUA" android:textSize="9sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvAgua" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/colorAgua" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ MOVILIDAD MATUTINA — colapsada por defecto (toca para ver
             la lista); solo el título ocupa espacio fijo, así una rutina
             larga no empuja el resto de la pantalla fuera de la vista. ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_flat"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/headerMovilidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tvMovilidadTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Movilidad matutina"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/success" />

                <TextView
                    android:id="@+id/tvMovilidadChevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▸"
                    android:textSize="13sp"
                    android:textColor="@color/success" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutMovilidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ═══ CORE (día de descanso) — colapsable como movilidad. Solo se
             muestra cuando el backend manda core_dia (días de descanso), si no
             la tarjeta entera queda oculta (cardCore GONE en HomeActivity). ═══ -->
        <LinearLayout
            android:id="@+id/cardCore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_flat"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/headerCore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tvCoreTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Core"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/success" />

                <TextView
                    android:id="@+id/tvCoreChevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▸"
                    android:textSize="13sp"
                    android:textColor="@color/success" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ═══ BOTÓN EMPEZAR ENTRENO ═══ -->
        <Button
            android:id="@+id/btnEmpezarEntreno"
            style="@style/Widget.FitBase.Button.Primary"
            android:layout_marginTop="12dp"
            android:text="EMPEZAR ENTRENO"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tvSesionTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSesionFase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- ═══ NAVEGACIÓN ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnPlanAnual"
                style="@style/Widget.FitBase.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Plan Anual"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnProgresion"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:contentDescription="Progresión"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chart"
                android:background="@drawable/button_secondary" />
        </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>

    <!-- ═══ BOTONES DE DESARROLLO (Constants.MOSTRAR_BOTONES_DEMO) ═══
         Flotantes, fuera del flujo del ScrollView, para no afectar la
         composición real. Visibilidad controlada en HomeActivity a partir
         de un único flag en código. -->
    <Button
        android:id="@+id/btnTest"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:alpha="0.85"
        android:paddingHorizontal="12dp"
        android:text="TEST"
        android:textSize="11sp"
        android:background="@drawable/button_secondary" />

    <Button
        android:id="@+id/btnPreviewFase"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="12dp"
        android:alpha="0.85"
        android:paddingHorizontal="12dp"
        android:text="FASE"
        android:textSize="11sp"
        android:background="@drawable/button_secondary" />

    <Button
        android:id="@+id/btnPreviewEntreno"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="12dp"
        android:alpha="0.85"
        android:paddingHorizontal="12dp"
        android:text="ENTRENO"
        android:textSize="11sp"
        android:background="@drawable/button_secondary" />

    <!-- Previsualiza el banner de Ramadán/Eid — solo cae ~1 mes/año, sin
         esto no habría forma de verlo el resto del tiempo. -->
    <Button
        android:id="@+id/btnPreviewRamadan"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="144dp"
        android:layout_marginEnd="12dp"
        android:alpha="0.85"
        android:paddingHorizontal="12dp"
        android:text="RAMADÁN"
        android:textSize="11sp"
        android:background="@drawable/button_secondary" />

</FrameLayout>
