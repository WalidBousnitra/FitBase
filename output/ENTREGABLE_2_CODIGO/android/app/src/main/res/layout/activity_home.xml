<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla Principal Mañana (ui.md § 3.2) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Banner Demo -->
        <TextView
            android:id="@+id/bannerDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorWarning"
            android:padding="12dp"
            android:text="🎮 MODO DEMO — Comienza el 31/08/2026"
            android:textColor="#000000"
            android:textAlignment="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Fecha -->
        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorTextSecondary"
            android:textSize="16sp"
            android:textAlignment="center"
            android:layout_marginBottom="24dp" />

        <!-- Card Calorías Principal -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <!-- Número gigante de calorías -->
                <TextView
                    android:id="@+id/tvCaloriasObjetivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3280"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="kcal"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <!-- Macros P/C/G -->
                <TextView
                    android:id="@+id/tvMacros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="P 156g  C 488g  G 78g"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Cards secundarias (Pasos + Agua) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Pasos -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvPasos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8000"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👟 pasos"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Agua -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:layout_marginStart="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvAgua"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.2L"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💧 agua"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Sesión del día -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvSesionHoy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hoy: Push Day (6 ejercicios, ~75 min)"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Botón Empezar Entreno -->
                <Button
                    android:id="@+id/btnEmpezarEntreno"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/gradient_primary_button"
                    android:text="▶  EMPEZAR ENTRENO"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botón Plan Anual -->
        <Button
            android:id="@+id/btnPlanAnual"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button_secondary"
            android:text="📅  Ver Plan Anual"
            android:textColor="@color/colorTextPrimary"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Banner Ausencia Detectada -->
        <LinearLayout
            android:id="@+id/bannerAusencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/colorSurface"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAusenciaMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorWarning"
                android:textSize="14sp"
                android:text="No entrenaste ayer. Se redistribuye volumen." />
        </LinearLayout>

        <!-- Botón Registrar Ausencia Extendida -->
        <Button
            android:id="@+id/btnRegistrarAusencia"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/button_secondary"
            android:text="⏸  Registrar ausencia larga"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
