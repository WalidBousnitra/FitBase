<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<!-- ═══ STACK RAÍZ: ocupa el 100% vertical disponible (insets de barra de
     estado/gestos ya aplicados como padding en InsetsHelper). El scroll de
     arriba se estira o encoge con el contenido del día; el bloque de
     acción de abajo queda siempre anclado al borde inferior real de la
     pantalla, en vez de flotar con hueco vacío debajo. ═══ -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══ HERO: saludo + fecha + chips de estado ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hero_panel"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_md">

            <TextView
                android:id="@+id/tvSaludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buenos días"
                android:textSize="@dimen/home_text_greeting"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="miércoles 2 de julio"
                android:textSize="@dimen/home_text_meta"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTipoDia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="@dimen/home_text_chip"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/accent"
                    android:background="@drawable/bg_chip_accent"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingVertical="@dimen/space_xs" />

                <TextView
                    android:id="@+id/tvFaseNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="Hipertrofia I"
                    android:textSize="@dimen/home_text_chip"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_badge_actual"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingVertical="@dimen/space_xs"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_md">

        <!-- ═══ BANNER AUSENCIA ═══ -->
        <LinearLayout
            android:id="@+id/bannerAusencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_flat"
            android:padding="@dimen/space_md"
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAusenciaMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/home_text_chip"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- ═══ BANNER RAMADÁN / EID (cultura.md §5-6) ═══ -->
        <LinearLayout
            android:id="@+id/bannerRamadan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_flat"
            android:padding="@dimen/space_md"
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRamadanTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/home_text_meta"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/tvRamadanDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textSize="@dimen/home_text_chip"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- ═══ ESTADO: sueño + FC + pasos, todo en una tarjeta ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_flat"
            android:padding="@dimen/space_md"
            android:layout_marginTop="@dimen/space_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SUEÑO"
                        android:textSize="@dimen/home_text_label"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:textColor="@color/text_tertiary" />
                    <TextView
                        android:id="@+id/tvSleepScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="@dimen/home_text_value_lg"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/colorSeparator" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FC REPOSO"
                        android:textSize="@dimen/home_text_label"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:textColor="@color/text_tertiary" />
                    <TextView
                        android:id="@+id/tvFcReposo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="@dimen/home_text_value_lg"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvAvisoFatiga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sueño pobre — sesión reducida"
                android:textSize="@dimen/home_text_chip"
                android:textColor="@color/warning"
                android:layout_marginTop="@dimen/space_xs"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorSeparator"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginBottom="@dimen/space_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPasos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="@dimen/home_text_value_md"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvPasosObj"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/ — pasos"
                    android:textSize="@dimen/home_text_meta"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginStart="@dimen/space_xxs" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressPasos"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="@dimen/space_xs"
                android:progressDrawable="@drawable/progress_pasos"
                android:max="8000" />

            <TextView
                android:id="@+id/tvCardioInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="20 min bici post-gym"
                android:textSize="@dimen/home_text_chip"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="@dimen/space_sm"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ═══ MACROS RESTANTES ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MACROS RESTANTES"
            android:textSize="@dimen/home_text_label"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:textColor="@color/text_tertiary"
            android:layout_marginTop="@dimen/space_sm" />

        <TextView
            android:id="@+id/tvCaloriasRestantes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="@dimen/home_text_value_xl"
            android:textColor="@color/accent"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02" />

        <ProgressBar
            android:id="@+id/progressCalorias"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="@dimen/space_xs"
            android:progressDrawable="@drawable/progress_calorias"
            android:max="3280" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_sm">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="@dimen/tile_padding">
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginBottom="@dimen/space_xxs"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/colorProteina" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PROT" android:textSize="@dimen/home_text_label_xs" android:fontFamily="sans-serif-medium" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvProtRestante" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textSize="@dimen/home_text_value_sm" android:fontFamily="sans-serif-medium" android:textColor="@color/colorProteina" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="@dimen/tile_padding"
                android:layout_marginStart="@dimen/space_sm">
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginBottom="@dimen/space_xxs"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/colorCarbos" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CARBOS" android:textSize="@dimen/home_text_label_xs" android:fontFamily="sans-serif-medium" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvCarbosRestantes" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textSize="@dimen/home_text_value_sm" android:fontFamily="sans-serif-medium" android:textColor="@color/colorCarbos" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="@dimen/tile_padding"
                android:layout_marginStart="@dimen/space_sm">
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginBottom="@dimen/space_xxs"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/colorGrasa" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="GRASA" android:textSize="@dimen/home_text_label_xs" android:fontFamily="sans-serif-medium" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvGrasasRestantes" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textSize="@dimen/home_text_value_sm" android:fontFamily="sans-serif-medium" android:textColor="@color/colorGrasa" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="@dimen/tile_padding"
                android:layout_marginStart="@dimen/space_sm">
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginBottom="@dimen/space_xxs"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/colorAgua" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="AGUA" android:textSize="@dimen/home_text_label_xs" android:fontFamily="sans-serif-medium" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvAgua" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textSize="@dimen/home_text_value_sm" android:fontFamily="sans-serif-medium" android:textColor="@color/colorAgua" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ MOVILIDAD MATUTINA — SIEMPRE visible al completo (no es
             desplegable): es relevante todos los días, así que no debe
             requerir un toque para verse. ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_card_flat"
            android:padding="@dimen/space_sm">

            <TextView
                android:id="@+id/tvMovilidadTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Movilidad matutina"
                android:textSize="@dimen/home_text_meta"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/success" />

            <LinearLayout
                android:id="@+id/layoutMovilidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_xxs" />
        </LinearLayout>

        <!-- ═══ CORE (día de descanso) — colapsable como movilidad. Solo se
             muestra cuando el backend manda core_dia (días de descanso), si no
             la tarjeta entera queda oculta (cardCore GONE en HomeActivity). ═══ -->
        <LinearLayout
            android:id="@+id/cardCore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_card_flat"
            android:padding="@dimen/space_sm"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/headerCore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tvCoreTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Core"
                    android:textSize="@dimen/home_text_meta"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/success" />

                <TextView
                    android:id="@+id/tvCoreChevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▸"
                    android:textSize="@dimen/home_text_meta"
                    android:textColor="@color/success" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_xs"
                android:visibility="gone" />
        </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>

    <!-- ═══ BLOQUE DE ACCIÓN FIJO — fuera del scroll, siempre anclado al
         borde inferior real de la pantalla (ver comentario del stack raíz
         arriba). Mismo padding horizontal que el contenido de scroll. ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_md">

        <!-- ═══ BOTÓN EMPEZAR ENTRENO ═══ -->
        <Button
            android:id="@+id/btnEmpezarEntreno"
            style="@style/Widget.FitBase.Button.Primary"
            android:layout_marginTop="@dimen/space_md"
            android:text="EMPEZAR ENTRENO"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tvSesionTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_xxs"
            android:textSize="@dimen/home_text_meta"
            android:textColor="@color/text_tertiary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSesionFase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- ═══ NAVEGACIÓN ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_sm">

            <Button
                android:id="@+id/btnPlanAnual"
                style="@style/Widget.FitBase.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Plan Anual"
                android:textSize="@dimen/home_text_meta" />

            <ImageButton
                android:id="@+id/btnProgresion"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="@dimen/space_sm"
                android:contentDescription="Progresión"
                android:padding="@dimen/space_md"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chart"
                android:background="@drawable/button_secondary" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

    <!-- ═══ BOTONES DE DESARROLLO (Constants.MOSTRAR_BOTONES_DEMO) ═══
         Flotantes, fuera del flujo del stack raíz, para no afectar la
         composición real. Visibilidad controlada en HomeActivity a partir
         de un único flag en código. Tamaño fijo a propósito (solo
         desarrollo, no forman parte del diseño responsive). -->
    <Button
        android:id="@+id/btnTest"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:alpha="0.85"
        android:paddingHorizontal="12dp"
        android:text="TEST"
        android:textSize="11sp"
        android:background="@drawable/button_secondary" />

    <Button
        android:id="@+id/btnPreviewFase"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="12dp"
        android:alpha="0.85"
        android:paddingHorizontal="12dp"
        android:text="FASE"
        android:textSize="11sp"
        android:background="@drawable/button_secondary" />

    <Button
        android:id="@+id/btnPreviewEntreno"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="12dp"
        android:alpha="0.85"
        android:paddingHorizontal="12dp"
        android:text="ENTRENO"
        android:textSize="11sp"
        android:background="@drawable/button_secondary" />

    <!-- Previsualiza el banner de Ramadán/Eid — solo cae ~1 mes/año, sin
         esto no habría forma de verlo el resto del tiempo. -->
    <Button
        android:id="@+id/btnPreviewRamadan"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="144dp"
        android:layout_marginEnd="12dp"
        android:alpha="0.85"
        android:paddingHorizontal="12dp"
        android:text="RAMADÁN"
        android:textSize="11sp"
        android:background="@drawable/button_secondary" />

</FrameLayout>
