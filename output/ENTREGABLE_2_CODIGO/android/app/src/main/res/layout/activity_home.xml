<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla Principal — Compacta, sin scroll ni huecos -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top">

    <!-- Banner preinicio -->
    <TextView
        android:id="@+id/bannerDemo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● Preinicio · Programa inicia 31/08/2026"
        android:textColor="@color/colorTextTertiary"
        android:textSize="11sp"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <!-- Banner Ausencia -->
    <LinearLayout
        android:id="@+id/bannerAusencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:paddingBottom="8dp">
        <TextView
            android:id="@+id/tvAusenciaMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorWarning"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Header: Saludo + Fecha en una línea -->
    <TextView
        android:id="@+id/tvSaludo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buenos días"
        android:textColor="@color/colorTextPrimary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/tvFecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/colorTextTertiary"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <!-- ═══ CALORÍAS (compacto) ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.6"
        android:orientation="vertical"
        android:paddingVertical="16dp"
        android:background="@color/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCaloriasRestantes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1830"
                android:textColor="@color/colorTextPrimary"
                android:textSize="32sp"
                android:fontFamily="sans-serif-light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" kcal restantes"
                android:textColor="@color/colorTextTertiary"
                android:textSize="13sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressCalorias"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="44"
            android:progressDrawable="@drawable/progress_calorias" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvCaloriasConsumidas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1450 consumidas"
                android:textColor="@color/colorTextTertiary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvCaloriasObjetivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="de 3280 kcal"
                android:textColor="@color/colorTextTertiary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Macros restantes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.6"
        android:orientation="horizontal"
        android:paddingVertical="14dp"
        android:gravity="center">

        <!-- Proteína -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvProteinaRestante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="96g"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prot rest."
                android:textColor="@color/colorTextTertiary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Carbos -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvCarbosRestantes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="288g"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carbs rest."
                android:textColor="@color/colorTextTertiary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Grasas -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvGrasasRestantes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="48g"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grasa rest."
                android:textColor="@color/colorTextTertiary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorSeparator"
        android:layout_marginVertical="10dp" />

    <!-- Pasos + Agua (una línea) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8"
        android:orientation="horizontal">

        <!-- Pasos -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvPasos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4,523"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvPasosObjetivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / 8,000"
                    android:textColor="@color/colorTextTertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressPasos"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                android:max="100"
                android:progress="56"
                android:progressDrawable="@drawable/progress_pasos" />
        </LinearLayout>

        <!-- Agua — solo objetivo diario -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💧 "
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAgua"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.2L"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" /día"
                android:textColor="@color/colorTextTertiary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorSeparator"
        android:layout_marginVertical="10dp" />

    <!-- Sesión del día -->
    <TextView
        android:id="@+id/tvSesionHoy"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:text="Push Day — 6 ejercicios, ~72 min"
        android:textColor="@color/colorTextPrimary"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical" />

    <TextView
        android:id="@+id/tvFaseInfo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:text=""
        android:textColor="@color/colorTextTertiary"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical" />

    <!-- BOTONES al fondo -->
    <Button
        android:id="@+id/btnEmpezarEntreno"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/gradient_primary_button"
        android:text="Empezar entreno"
        android:textColor="@color/colorBackground"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnPlanAnual"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/button_secondary"
            android:text="Plan"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnProgresion"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/button_secondary"
            android:text="Progresión"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:textAllCaps="false" />
    </LinearLayout>

    <Button
        android:id="@+id/btnRegistrarAusencia"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="2dp"
        android:background="@android:color/transparent"
        android:text="Registrar ausencia"
        android:textColor="@color/colorTextTertiary"
        android:textSize="11sp"
        android:textAllCaps="false" />

    <!-- Test Runner — Solo visible en DEMO -->
    <Button
        android:id="@+id/btnTestRunner"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="2dp"
        android:background="@android:color/transparent"
        android:text="🧪 Ejecutar Tests"
        android:textColor="@color/colorTextTertiary"
        android:textSize="11sp"
        android:textAllCaps="false"
        android:visibility="gone" />

    </LinearLayout>
</LinearLayout>
