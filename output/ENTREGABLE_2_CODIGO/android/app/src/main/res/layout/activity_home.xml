<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ═══ HEADER ═══ -->
        <TextView
            android:id="@+id/tvSaludo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buenos días"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="miércoles 2 de julio"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTipoDia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="16sp"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/tvFaseNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hipertrofia I"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:background="@drawable/bg_badge_actual"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ═══ BANNER AUSENCIA ═══ -->
        <LinearLayout
            android:id="@+id/bannerAusencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_flat"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAusenciaMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- ═══ BANNER RAMADÁN / EID (cultura.md §5-6) ═══ -->
        <LinearLayout
            android:id="@+id/bannerRamadan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_flat"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRamadanTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/tvRamadanDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- ═══ SUEÑO ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUEÑO (estimado)"
                    android:textSize="11sp"
                    android:textColor="@color/text_tertiary" />
                <TextView
                    android:id="@+id/tvSleepScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="@dimen/text_header"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FC REPOSO"
                    android:textSize="11sp"
                    android:textColor="@color/text_tertiary" />
                <TextView
                    android:id="@+id/tvFcReposo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="@dimen/text_header"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAvisoFatiga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sueño pobre — sesión reducida"
            android:textSize="13sp"
            android:textColor="@color/warning"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- ═══ MACROS RESTANTES ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MACROS RESTANTES"
            android:textSize="11sp"
            android:textColor="@color/text_tertiary"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tvCaloriasRestantes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="@dimen/text_display_metric"
            android:textColor="@color/accent"
            android:fontFamily="sans-serif-medium" />

        <ProgressBar
            android:id="@+id/progressCalorias"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:progressDrawable="@drawable/progress_calorias"
            android:max="3280" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PROT" android:textSize="10sp" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvProtRestante" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textSize="18sp" android:textColor="@color/colorProteina" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="10dp"
                android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CARBOS" android:textSize="10sp" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvCarbosRestantes" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textSize="18sp" android:textColor="@color/colorCarbos" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="10dp"
                android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="GRASA" android:textSize="10sp" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvGrasasRestantes" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textSize="18sp" android:textColor="@color/colorGrasa" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_macro_card"
                android:padding="10dp"
                android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="AGUA" android:textSize="10sp" android:textColor="@color/text_tertiary" />
                <TextView android:id="@+id/tvAgua" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textSize="18sp" android:textColor="@color/colorAgua" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ PASOS Y CARDIO ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPasos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvPasosObj"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/ — pasos"
                    android:textSize="14sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressPasos"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:progressDrawable="@drawable/progress_pasos"
                android:max="8000" />

            <TextView
                android:id="@+id/tvCardioInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="20 min bici post-gym"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ═══ MOVILIDAD MATUTINA ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_flat"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvMovilidadTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Movilidad matutina"
                android:textSize="14sp"
                android:textColor="@color/success" />

            <LinearLayout
                android:id="@+id/layoutMovilidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ═══ BOTÓN EMPEZAR ENTRENO ═══ -->
        <Button
            android:id="@+id/btnEmpezarEntreno"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="EMPEZAR ENTRENO"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:background="@drawable/gradient_primary_button"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tvSesionTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSesionFase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- ═══ NAVEGACIÓN ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btnPlanAnual"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="Plan Anual"
                android:textSize="13sp"
                android:background="@drawable/button_secondary" />

            <ImageButton
                android:id="@+id/btnProgresion"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="8dp"
                android:contentDescription="Progresión"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chart"
                android:background="@drawable/button_secondary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

    <!-- Botón de test: SOLO para desarrollo, flotante para no afectar al
         resto de la composición. No participa del flujo del layout. -->
    <Button
        android:id="@+id/btnTest"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:alpha="0.85"
        android:paddingHorizontal="12dp"
        android:text="TEST"
        android:textSize="11sp"
        android:background="@drawable/button_secondary" />

    <!-- Botón de previsualización de cambio de fase: SOLO para desarrollo,
         lanza CambioFaseActivity con datos de ejemplo (sin depender de que
         hoy sea un cambio real de fase). -->
    <Button
        android:id="@+id/btnPreviewFase"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="12dp"
        android:alpha="0.85"
        android:paddingHorizontal="12dp"
        android:text="FASE"
        android:textSize="11sp"
        android:background="@drawable/button_secondary" />

    <!-- Botón de previsualización de entreno: SOLO para desarrollo, lanza
         WorkoutActivity directamente sin pasar por el gate de tipo_dia de
         Home — así se puede probar el flujo de gym cualquier día (incluido
         descanso/natación real) sin depender de haber redesplegado
         Codigo.gs ni de qué día de la semana sea hoy. -->
    <Button
        android:id="@+id/btnPreviewEntreno"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="12dp"
        android:alpha="0.85"
        android:paddingHorizontal="12dp"
        android:text="ENTRENO"
        android:textSize="11sp"
        android:background="@drawable/button_secondary" />

</FrameLayout>
