<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla Principal — Linear App Aesthetic: plano, monocromático, micro-accents -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Banner Demo — sutil, borde fino -->
        <LinearLayout
            android:id="@+id/bannerDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/button_secondary"
            android:visibility="gone">

            <!-- Dot naranja micro-accent -->
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@color/colorAccentPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Demo · Programa inicia 31/08/2026"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <!-- Header: Saludo + Fecha -->
        <TextView
            android:id="@+id/tvSaludo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buenos días"
            android:textColor="@color/colorTextPrimary"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorTextTertiary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp" />

        <!-- ═══ SECCIÓN CALORÍAS ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="20dp"
            android:layout_marginBottom="1dp"
            android:background="@color/colorSurface">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calorías restantes"
                android:textColor="@color/colorTextTertiary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvCaloriasRestantes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1830"
                android:textColor="@color/colorTextPrimary"
                android:textSize="40sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginTop="4dp" />

            <!-- Progress — línea fina naranja (micro-accent) -->
            <ProgressBar
                android:id="@+id/progressCalorias"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progress="44"
                android:progressDrawable="@drawable/progress_calorias" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvCaloriasConsumidas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1450 consumidas"
                    android:textColor="@color/colorTextTertiary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvCaloriasObjetivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="de 3280 kcal"
                    android:textColor="@color/colorTextTertiary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Separador fino -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorSeparator" />

        <!-- Macros — monocromáticos, en línea -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="16dp"
            android:background="@color/colorSurface"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvProteinaRestante"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="84g"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proteína"
                    android:textColor="@color/colorTextTertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:background="@color/colorSeparator" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvCarbosRestantes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="308g"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carbos"
                    android:textColor="@color/colorTextTertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:background="@color/colorSeparator" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvGrasasRestantes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="44g"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grasas"
                    android:textColor="@color/colorTextTertiary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Separador sección -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorSeparator"
            android:layout_marginBottom="24dp" />

        <!-- ═══ PASOS + AGUA ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- Pasos -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pasos"
                    android:textColor="@color/colorTextTertiary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvPasos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4,523"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="2dp" />

                <ProgressBar
                    android:id="@+id/progressPasos"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="56"
                    android:progressDrawable="@drawable/progress_pasos" />

                <TextView
                    android:id="@+id/tvPasosObjetivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/ 8,000"
                    android:textColor="@color/colorTextTertiary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Separador vertical fino -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/colorSeparator" />

            <!-- Agua -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agua"
                    android:textColor="@color/colorTextTertiary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvAgua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.2L"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="2dp" />

                <ProgressBar
                    android:id="@+id/progressAgua"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="37"
                    android:progressDrawable="@drawable/progress_agua" />

                <TextView
                    android:id="@+id/tvAguaObjetivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/ 3.2L"
                    android:textColor="@color/colorTextTertiary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ SESIÓN DEL DÍA ═══ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorSeparator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entrenamiento"
                android:textColor="@color/colorTextTertiary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvSesionHoy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Push Day — 6 ejercicios, ~72 min"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvFaseInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/colorTextTertiary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <!-- Botón CTA — sólido oscuro, sin gradiente -->
            <Button
                android:id="@+id/btnEmpezarEntreno"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/gradient_primary_button"
                android:text="Empezar entreno"
                android:textColor="@color/colorBackground"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                android:letterSpacing="0.01"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorSeparator" />

        <!-- Plan Anual — texto plano con borde -->
        <Button
            android:id="@+id/btnPlanAnual"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/button_secondary"
            android:text="Ver Plan Anual"
            android:textColor="@color/colorTextPrimary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false" />

        <!-- Banner Ausencia -->
        <LinearLayout
            android:id="@+id/bannerAusencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="16dp"
            android:layout_marginTop="20dp"
            android:background="@color/colorSurfaceElevated"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAusenciaMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorWarning"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

        <!-- Registrar ausencia — texto terciario -->
        <Button
            android:id="@+id/btnRegistrarAusencia"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:text="Registrar ausencia"
            android:textColor="@color/colorTextTertiary"
            android:textSize="13sp"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
