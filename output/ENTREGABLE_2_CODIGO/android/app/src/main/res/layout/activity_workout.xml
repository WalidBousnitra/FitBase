<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de Entrenamiento (ui.md § 4) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contenedorPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvProgreso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1/6"
            android:textColor="@color/colorTextSecondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvTiempoTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ 0:00"
            android:textColor="@color/colorTextSecondary"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Contenido central: Ejercicio activo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="20dp">

        <!-- Nombre ejercicio -->
        <TextView
            android:id="@+id/tvNombreEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRESS INCLINADO"
            android:textColor="@color/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="32dp" />

        <!-- Peso sugerido (número gigante) -->
        <TextView
            android:id="@+id/tvPesoSugerido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18 kg"
            android:textColor="@color/colorTextPrimary"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Reps objetivo -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="16dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvRepsObjetivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 reps"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Serie actual -->
        <TextView
            android:id="@+id/tvSerieActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Serie 1 / 4"
            android:textColor="@color/colorTextSecondary"
            android:textSize="16sp"
            android:layout_marginTop="24dp" />

        <!-- Instrucción swipe -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀ swipe para completar ▶"
            android:textColor="@color/colorTextTertiary"
            android:textSize="13sp"
            android:layout_marginTop="48dp" />
    </LinearLayout>

    <!-- Overlay: Registro RIR (inicialmente oculto) -->
    <LinearLayout
        android:id="@+id/layoutRegistro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/colorBackground"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Cuántas hiciste?"
            android:textColor="@color/colorTextPrimary"
            android:textSize="22sp"
            android:layout_marginBottom="16dp" />

        <!-- Input reps (editable) -->
        <EditText
            android:id="@+id/tvRepsInput"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="10"
            android:textColor="@color/colorTextPrimary"
            android:textSize="36sp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:background="@color/colorSurface"
            android:padding="16dp"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Cuántas te quedaban? (RIR)"
            android:textColor="@color/colorTextPrimary"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Botones RIR: 0, 1, 2, 3, 4+ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnRir0"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="0"
                android:textSize="22sp"
                android:textColor="@color/colorTextPrimary"
                android:backgroundTint="@color/colorError"
                android:layout_margin="4dp" />

            <Button
                android:id="@+id/btnRir1"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="1"
                android:textSize="22sp"
                android:textColor="@color/colorTextPrimary"
                android:backgroundTint="@color/colorWarning"
                android:layout_margin="4dp" />

            <Button
                android:id="@+id/btnRir2"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="2"
                android:textSize="22sp"
                android:textColor="@color/colorTextPrimary"
                android:backgroundTint="@color/colorSuccess"
                android:layout_margin="4dp" />

            <Button
                android:id="@+id/btnRir3"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="3"
                android:textSize="22sp"
                android:textColor="@color/colorTextPrimary"
                android:backgroundTint="@color/colorChart"
                android:layout_margin="4dp" />

            <Button
                android:id="@+id/btnRir4"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="4+"
                android:textSize="22sp"
                android:textColor="@color/colorTextPrimary"
                android:backgroundTint="@color/colorSurface"
                android:layout_margin="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Overlay: Timer de descanso (inicialmente oculto) -->
    <LinearLayout
        android:id="@+id/layoutTimer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/colorBackground"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Timer gigante -->
        <TextView
            android:id="@+id/tvTimerCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2:00"
            android:textColor="@color/colorTextPrimary"
            android:textSize="72sp"
            android:textStyle="bold" />

        <!-- Info próxima serie -->
        <TextView
            android:id="@+id/tvProximaSerie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Próximo: Serie 2/4\n18 kg × 10"
            android:textColor="@color/colorTextSecondary"
            android:textSize="16sp"
            android:textAlignment="center"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀ swipe para saltar ▶"
            android:textColor="@color/colorTextTertiary"
            android:textSize="13sp"
            android:layout_marginTop="48dp" />
    </LinearLayout>

</FrameLayout>
