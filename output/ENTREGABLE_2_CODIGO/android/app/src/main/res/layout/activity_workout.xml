<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootWorkout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ═══ CARGANDO ═══ -->
    <LinearLayout
        android:id="@+id/layoutCargando"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">
        <ProgressBar android:layout_width="48dp" android:layout_height="48dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Cargando sesión..." android:textColor="@color/text_secondary"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- ═══ RUTINA (Calentamiento / Estiramientos) — pantalla completa,
         centrada, un item cada vez. Igual de minimalista que Ejercicio.
         Swipe izquierda → siguiente item (ver ui.md REG-DEV-01, Caso C) ═══ -->
    <LinearLayout
        android:id="@+id/layoutRutina"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvRutinaProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 / 5"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"
            android:padding="24dp" />

        <LinearLayout
            android:id="@+id/contenidoRutina"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/tvRutinaTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calentamiento"
                android:textSize="14sp"
                android:textColor="@color/text_tertiary"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvRutinaNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Círculos de cadera"
                android:textSize="24sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvRutinaValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10/lado"
                android:textSize="@dimen/text_display_metric"
                android:textColor="@color/accent"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="◀  desliza para siguiente  ▶"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"
            android:padding="28dp" />
    </LinearLayout>

    <!-- ═══ EJERCICIO ACTIVO — pantalla completa, centrada ═══
         Swipe izquierda → pasar a Registro RPE (ver ui.md REG-DEV-01 §4.2/§4.3) -->
    <LinearLayout
        android:id="@+id/layoutEjercicio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 / 6"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"
            android:padding="24dp" />

        <LinearLayout
            android:id="@+id/contenidoEjercicio"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/tvSerieInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Serie 1 / 4"
                android:textSize="14sp"
                android:textColor="@color/text_tertiary"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvNombreEjercicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Press hombro mancuernas"
                android:textSize="24sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginTop="12dp" />

            <!-- Peso AJUSTABLE — el sugerido por el motor es solo el punto de
                 partida (equipamiento disponible, sensación del día, o motor
                 sin histórico "Elige tu peso"). Lo que se ajusta aquí es lo
                 que se manda a ejercicios_log, así el motor sabe lo que de
                 verdad se levantó. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnPesoMenos"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:text="−"
                    android:textSize="20sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/button_secondary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <TextView
                    android:id="@+id/tvPesoSugerido"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="82.5 kg"
                    android:textSize="@dimen/text_display_metric"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeMaxTextSize="@dimen/text_display_metric"
                    android:maxLines="1"
                    android:textColor="@color/accent"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.02"
                    android:gravity="center"
                    android:layout_marginHorizontal="4dp" />

                <Button
                    android:id="@+id/btnPesoMas"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:text="+"
                    android:textSize="20sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/button_secondary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAjustePeso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toca − / + para ajustar el peso real"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvRepsObjetivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8-10 reps"
                android:textSize="18sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />

            <!-- Nota de seguridad del ejercicio (ej. dolor codo) — solo
                 visible cuando str_notas empieza por ⚠️ (ver Ejercicio.java). -->
            <TextView
                android:id="@+id/tvNotaEjercicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/warning"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="24dp"
                android:visibility="gone" />

            <!-- Aviso de superserie (preferencias.md §5) — sin descanso hasta
                 después del siguiente ejercicio. Solo visible si aplica. -->
            <TextView
                android:id="@+id/tvSuperserie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Superserie — sin descanso hasta el siguiente"
                android:textSize="12sp"
                android:textColor="@color/accent"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <!-- Detalle del motor: se sigue rellenando pero no se muestra
                 (pantalla minimalista, ver ui.md). -->
            <TextView android:id="@+id/tvMotorDetalle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:visibility="gone" />

            <TextView
                android:id="@+id/tvRirObjetivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RIR objetivo: 2"
                android:textSize="14sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="◀  desliza para completar  ▶"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"
            android:padding="28dp" />
    </LinearLayout>

    <!-- ═══ REGISTRO RPE — pantalla completa, centrada (ui.md §4.3) ═══ -->
    <LinearLayout
        android:id="@+id/layoutRegistro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Cuántas reps hiciste?"
            android:textSize="16sp"
            android:textColor="@color/text_secondary" />

        <NumberPicker
            android:id="@+id/pickerReps"
            android:layout_width="100dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Cómo fue la sensación?"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="32dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button android:id="@+id/btnSensacionFacil"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:text="FÁCIL\nRIR 3+" android:textSize="11sp"
                android:background="@drawable/button_secondary" />

            <Button android:id="@+id/btnSensacionBien"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="BIEN\nRIR 2" android:textSize="11sp"
                android:background="@drawable/gradient_primary_button" android:textColor="@color/white" />

            <Button android:id="@+id/btnSensacionDuro"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="DURO\nRIR 1" android:textSize="11sp"
                android:background="@drawable/button_secondary" />

            <Button android:id="@+id/btnSensacionFallo"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="FALLO\nRIR 0" android:textSize="11sp"
                android:background="@drawable/button_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ TIMER — pantalla completa (ui.md §4.4). Swipe izquierda → saltar ═══ -->
    <LinearLayout
        android:id="@+id/layoutTimer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/surface"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvProximaSerie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descanso — próxima serie en:"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <Chronometer
            android:id="@+id/tvTimerCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2:00"
            android:textSize="@dimen/text_timer_hero"
            android:textColor="@color/accent"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvProximaInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Próximo: Serie 2 / 4"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="◀  desliza para saltar  ▶"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"
            android:layout_marginTop="40dp" />
    </LinearLayout>

    <!-- ═══ CARDIO ═══ -->
    <LinearLayout
        android:id="@+id/layoutCardio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cardio Post-Gym"
            android:textSize="22sp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvCardioInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15-20 min bici estática\n60-70% FC máx"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnFinCardio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:text="CARDIO COMPLETADO"
            android:background="@drawable/gradient_primary_button"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnSkipCardio"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="8dp"
            android:text="Saltar cardio hoy"
            android:textSize="13sp"
            android:background="@drawable/button_secondary" />
    </LinearLayout>

    <!-- ═══ RESUMEN ═══ -->
    <ScrollView
        android:id="@+id/layoutResumen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sesión completada"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/success" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                    android:background="@drawable/bg_card_flat" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="SERIES" android:textSize="11sp" android:textColor="@color/text_tertiary" />
                    <TextView android:id="@+id/tvResumenSeries" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—"
                        android:textSize="24sp" android:fontFamily="sans-serif-black" android:textColor="@color/accent" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                    android:background="@drawable/bg_card_flat" android:padding="14dp"
                    android:layout_marginStart="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="VOLUMEN" android:textSize="11sp" android:textColor="@color/text_tertiary" />
                    <TextView android:id="@+id/tvResumenVolumen" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—"
                        android:textSize="24sp" android:fontFamily="sans-serif-black" android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                    android:background="@drawable/bg_card_flat" android:padding="14dp"
                    android:layout_marginStart="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="RIR MEDIO" android:textSize="11sp" android:textColor="@color/text_tertiary" />
                    <TextView android:id="@+id/tvResumenRir" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—"
                        android:textSize="24sp" android:fontFamily="sans-serif-black" android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvResumenIntensidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alta — zona óptima hipertrofia"
                android:textSize="15sp"
                android:textColor="@color/success"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvResumenImpacto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="El motor usará estos datos para ajustar tu próxima sesión."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:text="CERRAR"
                android:background="@drawable/gradient_primary_button"
                android:textColor="@color/white" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
