<?xml version="1.0" encoding="utf-8"?>
<!-- Workout Screen — Modern Flat UI: monocromático, 8pt grid, micro-accents -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contenedorPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Barra superior: progreso + tiempo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvProgreso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1/6"
            android:textColor="@color/colorTextTertiary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvTiempoTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/colorTextTertiary"
            android:textSize="14sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Estado principal: Ejercicio activo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp">

        <!-- Nombre ejercicio -->
        <TextView
            android:id="@+id/tvNombreEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Press Inclinado"
            android:textColor="@color/colorTextPrimary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"
            android:layout_marginBottom="32dp" />

        <!-- Peso sugerido -->
        <TextView
            android:id="@+id/tvPesoSugerido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18 kg"
            android:textColor="@color/colorTextPrimary"
            android:textSize="48sp"
            android:fontFamily="sans-serif-light"
            android:layout_marginBottom="24dp" />

        <!-- Reps objetivo — borde sutil en vez de card -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingVertical="16dp"
            android:gravity="center"
            android:background="@drawable/button_secondary">

            <TextView
                android:id="@+id/tvRepsObjetivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 reps"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Serie actual -->
        <TextView
            android:id="@+id/tvSerieActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Serie 1 / 4"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="24dp" />

        <!-- Instrucción swipe -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="desliza para completar"
            android:textColor="@color/colorTextTertiary"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="48dp" />
    </LinearLayout>

    <!-- Overlay: Registro RIR -->
    <LinearLayout
        android:id="@+id/layoutRegistro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/colorBackground"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Repeticiones realizadas"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <!-- Input reps -->
        <EditText
            android:id="@+id/tvRepsInput"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="10"
            android:textColor="@color/colorTextPrimary"
            android:textSize="40sp"
            android:textAlignment="center"
            android:fontFamily="sans-serif-light"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:layout_marginBottom="32dp" />

        <!-- Separador fino -->
        <View
            android:layout_width="80dp"
            android:layout_height="2dp"
            android:background="@color/colorAccentPrimary"
            android:layout_marginTop="-32dp"
            android:layout_marginBottom="40dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RIR (repeticiones en reserva)"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <!-- Botones RIR: monocromáticos con borde, neutros -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnRir0"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="0"
                android:textSize="18sp"
                android:textColor="@color/colorTextPrimary"
                android:backgroundTint="@color/colorSurfaceElevated"
                android:layout_margin="4dp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnRir1"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="1"
                android:textSize="18sp"
                android:textColor="@color/colorTextPrimary"
                android:backgroundTint="@color/colorSurfaceElevated"
                android:layout_margin="4dp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnRir2"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="2"
                android:textSize="18sp"
                android:textColor="@color/colorTextPrimary"
                android:backgroundTint="@color/colorSurfaceElevated"
                android:layout_margin="4dp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnRir3"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="3"
                android:textSize="18sp"
                android:textColor="@color/colorTextPrimary"
                android:backgroundTint="@color/colorSurfaceElevated"
                android:layout_margin="4dp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnRir4"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="4+"
                android:textSize="18sp"
                android:textColor="@color/colorTextPrimary"
                android:backgroundTint="@color/colorSurfaceElevated"
                android:layout_margin="4dp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- Overlay: Timer de descanso -->
    <LinearLayout
        android:id="@+id/layoutTimer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/colorBackground"
        android:padding="24dp"
        android:visibility="gone">

        <!-- Timer -->
        <TextView
            android:id="@+id/tvTimerCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2:00"
            android:textColor="@color/colorTextPrimary"
            android:textSize="64sp"
            android:fontFamily="sans-serif-light" />

        <!-- Info próxima serie -->
        <TextView
            android:id="@+id/tvProximaSerie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Próximo: Serie 2/4"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:textAlignment="center"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="desliza para saltar"
            android:textColor="@color/colorTextTertiary"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="48dp" />
    </LinearLayout>

</FrameLayout>
