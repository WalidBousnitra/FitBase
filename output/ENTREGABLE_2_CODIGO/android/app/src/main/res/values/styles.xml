<?xml version="1.0" encoding="utf-8"?>
<!-- Design System: Typography Styles -->
<resources>

    <!-- Base parent (required for dot-notation inheritance) -->
    <style name="TextAppearance.FitBase" parent="android:TextAppearance" />
    <style name="Widget.FitBase.Button" parent="" />

    <!-- Display: Números grandes (calorías, peso, timer) — peso fuerte y
         tracking negativo, como en las apps de referencia actuales -->
    <style name="TextAppearance.FitBase.Display">
        <item name="android:textSize">48sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Headline: Títulos de sección -->
    <style name="TextAppearance.FitBase.Headline">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Title: Subtítulos -->
    <style name="TextAppearance.FitBase.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <!-- Body: Texto principal -->
    <style name="TextAppearance.FitBase.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
    </style>

    <!-- Caption: Etiquetas, metadata -->
    <style name="TextAppearance.FitBase.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorTextTertiary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Button: Botones CTA -->
    <style name="Widget.FitBase.Button.Primary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/gradient_primary_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Button: Botones secundarios (superficie elevada, sin borde) -->
    <style name="Widget.FitBase.Button.Secondary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Button: Filtro compacto (7d/30d/90d...) — el estado seleccionado se
         alterna en código entre bg_chip_accent (activo) y button_secondary
         (inactivo), ver ProgressionActivity.actualizarFiltroSeleccionado(). -->
    <style name="Widget.FitBase.Button.Filter">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Botón de icono en cabecera (volver / acción) — mismo componente en
         todas las pantallas con header (Plan Anual, Horario, Progresión...). -->
    <style name="Widget.FitBase.HeaderIconButton" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- Animación de "pulsado" (escala ligera) aplicada a TODOS los botones
         de la app vía themes.xml (android:buttonStyle / materialButtonStyle /
         android:imageButtonStyle) — un solo sitio en vez de repetirlo en cada
         layout. Los estilos base (Material) se mantienen intactos, solo se
         añade el stateListAnimator. -->
    <style name="Widget.FitBase.Button.Press" parent="Widget.MaterialComponents.Button">
        <item name="android:stateListAnimator">@animator/btn_press_scale</item>
    </style>

    <style name="Widget.FitBase.ImageButton.Press" parent="Widget.AppCompat.ImageButton">
        <item name="android:stateListAnimator">@animator/btn_press_scale</item>
    </style>

</resources>
