<?xml version="1.0" encoding="utf-8"?>
<!-- Theme: Modern Flat UI -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FitBase" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Accent -->
        <item name="colorPrimary">@color/colorAccentPrimary</item>
        <item name="colorPrimaryVariant">@color/colorTextPrimary</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Secondary: neutral -->
        <item name="colorSecondary">@color/colorTextSecondary</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>

        <!-- System bars: blend with background — iconos claros porque el
             fondo es siempre oscuro (MODE_NIGHT_YES forzado). windowLightStatusBar
             en true aquí sería un bug: pintaría los iconos del sistema oscuros
             sobre fondo oscuro, invisibles. -->
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- No action bar -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>

        <!-- Typography: system sans-serif -->
        <item name="android:fontFamily">sans-serif</item>

        <!-- Feedback visual de pulsado (escala) para TODOS los botones —
             framework Button/ImageButton y MaterialButton explícito, ver
             Widget.FitBase.Button.Press en styles.xml. -->
        <item name="android:buttonStyle">@style/Widget.FitBase.Button.Press</item>
        <item name="materialButtonStyle">@style/Widget.FitBase.Button.Press</item>
        <item name="android:imageButtonStyle">@style/Widget.FitBase.ImageButton.Press</item>
    </style>
</resources>
