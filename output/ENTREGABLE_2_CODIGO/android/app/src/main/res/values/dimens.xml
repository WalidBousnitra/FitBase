<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Radios (Modern Soft: grandes, "bento") -->
    <dimen name="radius_card">20dp</dimen>
    <dimen name="radius_button">16dp</dimen>
    <dimen name="radius_pill">100dp</dimen>

    <!-- Escala de espaciado — usar SIEMPRE uno de estos en vez de dp sueltos,
         para que márgenes/paddings no diverjan pantalla a pantalla. -->
    <dimen name="space_xxs">4dp</dimen>
    <dimen name="space_xs">6dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">20dp</dimen>
    <dimen name="space_xxl">24dp</dimen>
    <dimen name="space_xxxl">32dp</dimen>

    <!-- Padding estándar de pantalla completa (todas las Activity de nivel
         superior usan este mismo valor horizontal) -->
    <dimen name="screen_padding">20dp</dimen>
    <!-- Padding estándar de una card de contenido (bg_card_flat) -->
    <dimen name="card_padding">16dp</dimen>
    <!-- Padding de un tile denso en grid (bg_macro_card cuando van 3-4 en fila) -->
    <dimen name="tile_padding">10dp</dimen>

    <!-- Área táctil mínima Material (48dp) — NO 44dp, ese es el valor de Apple HIG. -->
    <dimen name="touch_target_min">48dp</dimen>

    <!-- Tipografía -->
    <dimen name="text_display_metric">36sp</dimen>
    <dimen name="text_header">22sp</dimen>

    <!-- Hero: peso sugerido en pantalla de ejercicio -->
    <dimen name="text_hero">64sp</dimen>
    <!-- Timer (número hero, cuenta atrás) -->
    <dimen name="text_timer_hero">72sp</dimen>

    <!-- Tipografía propia de Home (escala bespoke del dashboard matutino,
         no coincide con TextAppearance.FitBase genérico) — en su propio
         dimen para que values-sw600dp pueda escalarla en tablet. -->
    <dimen name="home_text_greeting">23sp</dimen>
    <dimen name="home_text_meta">13sp</dimen>
    <dimen name="home_text_chip">12sp</dimen>
    <dimen name="home_text_label">10sp</dimen>
    <dimen name="home_text_label_xs">9sp</dimen>
    <dimen name="home_text_value_sm">16sp</dimen>
    <dimen name="home_text_value_md">18sp</dimen>
    <dimen name="home_text_value_lg">20sp</dimen>
    <dimen name="home_text_value_xl">28sp</dimen>
</resources>
