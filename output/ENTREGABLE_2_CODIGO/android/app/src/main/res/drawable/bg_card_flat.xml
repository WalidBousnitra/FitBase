<?xml version="1.0" encoding="utf-8"?>
<!-- Card moderna: radio grande + sombra horneada en capa (sin depender de
     elevation nativa, resultado idéntico en cualquier API/dispositivo). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <solid android:color="@color/colorShadow" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <solid android:color="@color/colorSurface" />
        </shape>
    </item>
</layer-list>
