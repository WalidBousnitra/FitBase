<?xml version="1.0" encoding="utf-8"?>
<!-- Botón secundario — superficie elevada con sombra horneada, sin borde
     (la profundidad ya la da la sombra, coherente con el resto del sistema). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_button" />
            <solid android:color="@color/colorShadow" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_button" />
            <solid android:color="@color/colorSurfaceElevated2" />
        </shape>
    </item>
</layer-list>
