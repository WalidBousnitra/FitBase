<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Health Connect -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_BODY_WATER_MASS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".FitBaseApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FitBase"
        android:supportsRtl="true"
        tools:targetApi="36">

        <!-- Pantalla de carga inicial: precarga datos en segundo plano antes de Home -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.FitBase">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla principal (Mañana) -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Pantalla de entrenamiento (Gym) -->
        <activity
            android:name=".ui.workout.WorkoutActivity"
            android:screenOrientation="portrait"
            android:keepScreenOn="true" />

        <!-- Pantalla resumen fin de sesión -->
        <activity
            android:name=".ui.summary.SummaryActivity"
            android:screenOrientation="portrait" />

        <!-- Pantalla Plan Anual -->
        <activity
            android:name=".ui.plan.PlanAnualActivity"
            android:screenOrientation="portrait" />

        <!-- Horario semanal (qué tipo de sesión le toca a cada día) -->
        <activity
            android:name=".ui.plan.HorarioSemanalActivity"
            android:screenOrientation="portrait" />

        <!-- Cierre de fase anterior + presentación de fase nueva -->
        <activity
            android:name=".ui.plan.CambioFaseActivity"
            android:screenOrientation="portrait" />

        <!-- Pantalla Progresion Metricas -->
        <activity
            android:name=".ui.progression.ProgressionActivity"
            android:screenOrientation="portrait" />

        <!-- Test Runner (solo demo) -->
        <activity
            android:name=".ui.test.TestRunnerActivity"
            android:screenOrientation="portrait" />

        <!-- Servicio Timer (Foreground) -->
        <service
            android:name=".service.TimerService"
            android:foregroundServiceType="shortService"
            android:exported="false" />

        <!-- Botón "Detener" de la alarma de fin de descanso — receptor estático,
             no depende de que TimerService (ni la app) esté vivo. -->
        <receiver
            android:name=".service.TimerDetenerReceiver"
            android:exported="false" />

        <!-- FileProvider: para compartir el log de test (Test Runner → Compartir) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Health Connect -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".ui.home.HomeActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

    </application>

    <!-- Health Connect intents -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

</manifest>
